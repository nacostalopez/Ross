# Production environment for ross.ar — copy each value into the platform's
# variables (Railway: each service's Variables tab), never into the repo.
# Layout: the site (landing, pricing, app) on https://ross.ar, the API on
# https://api.ross.ar. See DEPLOY.md.

# --- backend service ---------------------------------------------------------

ENVIRONMENT=production
# Railway: a reference to the database service, e.g.
# postgresql+psycopg2://${{db.POSTGRES_USER}}:${{db.POSTGRES_PASSWORD}}@${{db.RAILWAY_PRIVATE_DOMAIN}}:5432/${{db.POSTGRES_DB}}
DATABASE_URL=

# Generate both; the app refuses to start on the dev defaults.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe: losing it makes every stored provider token unreadable.
CREDENTIALS_ENCRYPTION_KEY=

FRONTEND_URL=https://ross.ar
CORS_ALLOWED_ORIGINS=https://ross.ar,https://www.ross.ar

# Email (Resend over SMTP), once ross.ar is verified in Resend.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM_EMAIL=ross@ross.ar
SMTP_USE_TLS=true
DEMO_REQUEST_NOTIFY_EMAIL=
DEMO_VIEWER_EMAIL=

# OAuth return URLs: register each one, exactly, in that provider's app.
SHOPIFY_REDIRECT_URI=https://ross.ar/index.html?connector=shopify
META_REDIRECT_URI=https://ross.ar/index.html?connector=meta
GOOGLE_REDIRECT_URI=https://ross.ar/index.html?connector=google
TIKTOK_REDIRECT_URI=https://ross.ar/index.html?connector=tiktok
LINKEDIN_REDIRECT_URI=https://ross.ar/index.html?connector=linkedin
TIENDANUBE_REDIRECT_URI=https://ross.ar/index.html?connector=tiendanube
MERCADOLIBRE_REDIRECT_URI=https://ross.ar/index.html?connector=mercadolibre
MERCADOPAGO_REDIRECT_URI=https://ross.ar/index.html?connector=mercadopago

# Provider credentials: fill in as each app gets registered (names and
# scopes as in .env.example).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DEVELOPER_TOKEN=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIENDANUBE_CLIENT_ID=
TIENDANUBE_CLIENT_SECRET=
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=
MERCADOLIBRE_AUTH_DOMAIN=auth.mercadolibre.com.ar
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_BILLING_ACCESS_TOKEN=
MERCADOPAGO_BILLING_WEBHOOK_SECRET=
BILLING_CURRENCY=ARS

# --- db service ----------------------------------------------------------------

POSTGRES_USER=ross
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
POSTGRES_DB=ross
