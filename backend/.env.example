# Database
DATABASE_URL=postgresql+psycopg2://escal:escal@localhost:5432/escal
TEST_DATABASE_URL=postgresql+psycopg2://test:test@localhost:5433/escal_test

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Fernet encryption for credentials
CREDENTIALS_ENCRYPTION_KEY=Qxsu0Kb675R0dWY-WeAE-1hvcXLTQj74_pJrlsr_kG4=

# "development" | "test" | "production" — production refuses to boot if
# JWT_SECRET/CREDENTIALS_ENCRYPTION_KEY are still their dev defaults.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Shopify OAuth — create an app at partners.shopify.com, get its API
# key/secret from "Client credentials", and register the *_REDIRECT_URI
# value below verbatim as an allowed redirect URL in the app's settings
# (it points at the frontend's index.html, not a backend route — see the
# comment on ShopifySettings.shopify_redirect_uri for why).
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_REDIRECT_URI=http://localhost:3100/index.html?connector=shopify
SHOPIFY_SCOPES=read_orders,write_orders,read_products,write_products

# Meta (Facebook) Ads OAuth — create an app at developers.facebook.com,
# add the Marketing API product, get the App ID/secret, and register
# META_REDIRECT_URI as a valid OAuth redirect URI for that app.
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:3100/index.html?connector=meta
META_SCOPES=ads_management,ads_read

# Google Ads OAuth — create an OAuth 2.0 client (type "Web application")
# in console.cloud.google.com, register GOOGLE_REDIRECT_URI as an
# authorized redirect URI on it, and separately apply for a developer
# token at ads.google.com (API Center) — that approval can take longer
# than the OAuth client setup, so start it first.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3100/index.html?connector=google
GOOGLE_SCOPES=https://www.googleapis.com/auth/adwords
GOOGLE_DEVELOPER_TOKEN=your_google_ads_developer_token

# TikTok Ads OAuth — create an app at business.tiktok.com/marketing_api
# (Marketing API product), get the App ID/secret, and register
# TIKTOK_REDIRECT_URI as an allowed redirect URI for that app. No *_SCOPES
# var: TikTok's authorize page grants whatever the app itself was approved
# for, it isn't chosen per request like Meta/Google. Instagram and YouTube
# ad spend already arrive through the Meta/Google connectors above (same
# ad account/API as Facebook/Search/Display), so neither needs a connector
# of its own.
TIKTOK_APP_ID=your_tiktok_app_id
TIKTOK_APP_SECRET=your_tiktok_app_secret
TIKTOK_REDIRECT_URI=http://localhost:3100/index.html?connector=tiktok

# LinkedIn Ads OAuth — create an app at developer.linkedin.com, request the
# Marketing Developer Platform product (needed for r_ads/r_ads_reporting),
# and register LINKEDIN_REDIRECT_URI as an authorized redirect URL.
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3100/index.html?connector=linkedin
LINKEDIN_SCOPES=r_ads,r_ads_reporting

# Tiendanube OAuth
TIENDANUBE_CLIENT_ID=your_tiendanube_client_id
TIENDANUBE_CLIENT_SECRET=your_tiendanube_client_secret
TIENDANUBE_REDIRECT_URI=http://localhost:3100/auth/tiendanube/callback
TIENDANUBE_SCOPES=read_orders,read_products

# Mercado Libre OAuth (marketplace orders + Product Ads spend) — create an
# app at developers.mercadolibre.com.ar (Mis aplicaciones), with scopes
# read + offline_access and the "Orders" and "Advertising" permissions.
# Register MERCADOLIBRE_REDIRECT_URI as its redirect URI, and set its
# "Notifications callback URL" to <API>/connectors/mercadolibre/notifications
# subscribed to the orders_v2 topic (must be reachable from the internet).
# MERCADOLIBRE_AUTH_DOMAIN is the consent screen of the sellers' country
# (auth.mercadolibre.com.ar, auth.mercadolibre.com.mx, auth.mercadolivre.com.br...).
MERCADOLIBRE_CLIENT_ID=your_mercadolibre_app_id
MERCADOLIBRE_CLIENT_SECRET=your_mercadolibre_client_secret
MERCADOLIBRE_REDIRECT_URI=http://localhost:3100/index.html?connector=mercadolibre
MERCADOLIBRE_AUTH_DOMAIN=auth.mercadolibre.com.ar

# Mercado Pago OAuth (a merchant's own payments and processing fees) —
# an app at mercadopago.com.ar/developers (Tus integraciones), with
# MERCADOPAGO_REDIRECT_URI as its redirect URL. In its Webhooks panel set
# <API>/connectors/mercadopago/notifications for the "Pagos" event and copy
# the panel's "clave secreta" into MERCADOPAGO_WEBHOOK_SECRET — it is NOT
# the client secret.
MERCADOPAGO_CLIENT_ID=your_mercadopago_client_id
MERCADOPAGO_CLIENT_SECRET=your_mercadopago_client_secret
MERCADOPAGO_REDIRECT_URI=http://localhost:3100/index.html?connector=mercadopago
MERCADOPAGO_SCOPES=offline_access read write
MERCADOPAGO_WEBHOOK_SECRET=your_mercadopago_webhook_secret

# Billing — charging ARAMAL's own customers with Mercado Pago Suscripciones.
# ARAMAL's own account, separate from the connector app above: its access
# token (Tus integraciones > Credenciales de producción), and a webhook at
# <API>/billing/webhooks/mercadopago for the "Planes y suscripciones"
# events, whose clave secreta goes in MERCADOPAGO_BILLING_WEBHOOK_SECRET.
# Mercado Pago only charges in the account's local currency.
MERCADOPAGO_BILLING_ACCESS_TOKEN=your_aramal_mercadopago_access_token
MERCADOPAGO_BILLING_WEBHOOK_SECRET=your_billing_webhook_secret
BILLING_CURRENCY=ARS

# Used to build links in outgoing emails (e.g. invite links)
FRONTEND_URL=http://localhost:3100

# Outgoing email (invite emails) — SMTP_HOST left blank means emails are
# logged instead of sent, so local dev/tests need no real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@escal.app
SMTP_USE_TLS=true
